# Dependencies
/node_modules

# Build output. Deliberately NOT committed on the source branch: the deploy
# workflow builds from source and commits the bundle onto the BUILD branch.
# A dist/ checked into source would go stale and confuse which artifact is real.
/dist

# Local env / editor noise
.env
.env.*
.DS_Store
*.local

# Test + tooling caches
/coverage
/.vite
/.yarn/install-state.gz
